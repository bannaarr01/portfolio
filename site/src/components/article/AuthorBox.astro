---
/**
 * AuthorBox — the panel that closes the prose column.
 * Owner: group 05.
 */
import Avatar from '../ui/Avatar.astro';

interface Props {
  name: string;
  role?: string;
  bio: string;
  initials: string;
  /** Where "read more from this author" points. */
  href?: string;
}

const { name, role, bio, initials, href = '/blog/' } = Astro.props;
---

<aside class="author" aria-label={`About ${name}`}>
  <Avatar initials={initials} size={44} />

  <div class="author__body">
    <p class="author__kicker">Written by</p>
    <h2 class="author__name">{name}</h2>
    {role && <p class="author__role">{role}</p>}
    <p class="author__bio">{bio}</p>
    <a class="author__link" href={href}>More from this author</a>
  </div>
</aside>

<style>
  .author {
    display: flex;
    gap: 18px;
    margin-top: 12px;
    padding: 26px 28px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }

  .author__body {
    min-width: 0;
  }

  .author__kicker {
    margin: 0;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .author__name {
    margin: 6px 0 0;
    font-size: 22px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .author__role {
    margin: 4px 0 0;
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
  }

  .author__bio {
    max-width: 62ch;
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .author__link {
    display: inline-block;
    margin-top: 14px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--accent);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-strong);
    text-decoration: none;
    transition: border-color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .author__link:hover {
    border-bottom-color: var(--accent-strong);
  }

  @media (max-width: 620px) {
    .author {
      flex-direction: column;
      gap: 14px;
      padding: 22px;
    }
  }
</style>
