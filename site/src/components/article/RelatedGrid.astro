---
/**
 * RelatedGrid — the "keep reading" band beneath the article.
 *
 * Takes whatever getRelatedPosts() returns (already excluding the current
 * post) and renders nothing at all when that comes back empty, so a site
 * with one article doesn't show a headed band over blank space.
 *
 * Owner: group 05.
 */
import BlogCard from '../journal/BlogCard.astro';
import Icon from '../ui/Icon.astro';
import type { Post } from '../../types/content';

interface Props {
  posts: Post[];
  kicker?: string;
  heading?: string;
  viewAllHref?: string;
}

const {
  posts,
  kicker = 'Continue reading',
  heading = 'More from the journal',
  viewAllHref = '/blog/',
} = Astro.props;
---

{
  posts.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <div class="related__inner">
        <div class="rail">
          <div>
            <p class="rail__kicker">{kicker}</p>
            <h2 class="rail__heading" id="related-heading">
              {heading}
            </h2>
          </div>

          <a class="rail__link" href={viewAllHref}>
            View all
            <Icon name="arrow-right" size={15} />
          </a>
        </div>

        <div class="related__grid">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .related {
    margin-top: 78px;
    padding: 74px 0;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .related__inner {
    width: var(--container);
    margin-inline: auto;
  }

  .rail {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .rail__kicker {
    margin: 0 0 8px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .rail__heading {
    margin: 0;
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--text);
  }

  .rail__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--accent-strong);
    text-decoration: none;
    transition: gap 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rail__link:hover {
    gap: 12px;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px 30px;
    margin-top: 40px;
  }

  @media (max-width: 1000px) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .related {
      padding: 56px 0;
    }

    .related__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .rail {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__link {
      transition: none;
    }

    .rail__link:hover {
      gap: 7px;
    }
  }
</style>
