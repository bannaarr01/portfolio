---
/**
 * StructuredData — JSON-LD, dropped into BaseLayout's `head` slot. Group 06.
 *
 *   <StructuredData slot="head" person />                        homepage
 *   <StructuredData slot="head" article={…} breadcrumbs={…} />   articles
 *   <StructuredData slot="head" breadcrumbs={…} />               taxonomy pages
 *
 * Everything goes into one `@graph` so a page never ships two competing script
 * blocks and `author` can reference the Person node by `@id` instead of
 * restating it.
 *
 * `jobTitle`, `email`, and `sameAs` now read from `data/profile.ts` (wired at
 * integration, once group 07 landed). `sameAs` still self-censors: it only
 * emits profile URLs that are actually set.
 */
import { SITE_OWNER } from '../layout/nav';
import { profile } from '../../data/profile';
import { OG_DEFAULT } from './meta';

export interface Crumb {
  name: string;
  /** Path or absolute URL; resolved against `Astro.site`. */
  url: string;
}

export interface ArticleNode {
  title: string;
  description: string;
  url: string;
  image: string;
  publishDate: Date;
  updatedDate?: Date;
  section?: string;
  tags?: readonly string[];
}

interface Props {
  person?: boolean;
  article?: ArticleNode;
  breadcrumbs?: readonly Crumb[];
}

const { person = false, article, breadcrumbs } = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error('StructuredData.astro: `site` is not set in astro.config.mjs.');
}

const abs = (path: string) => new URL(path, site).href;
const PERSON_ID = `${abs('/')}#person`;

/** Google truncates `headline` past 110 characters. Doing it here keeps the cut
 *  on a word boundary rather than mid-syllable. */
function headline(value: string, limit = 110): string {
  if (value.length <= limit) return value;
  const cut = value.slice(0, limit - 1);
  const space = cut.lastIndexOf(' ');
  return `${(space > limit * 0.6 ? cut.slice(0, space) : cut).trimEnd()}…`;
}

const graph: Record<string, unknown>[] = [];

if (person) {
  // `sameAs` only carries profiles that actually exist. An empty array, or one
  // holding a placeholder URL, is worse than the absent property: Google treats
  // `sameAs` as an identity claim and a broken entry devalues the whole node.
  const sameAs = profile.socials
    .filter((social) => social.href !== '' && !social.href.startsWith('mailto:'))
    .map((social) => social.href);

  graph.push({
    '@type': 'Person',
    '@id': PERSON_ID,
    name: SITE_OWNER,
    url: abs('/'),
    // A raster URL, not the SVG mark: validators are inconsistent about SVG in
    // structured data and the generated card costs nothing to point at.
    image: abs(OG_DEFAULT),
    jobTitle: profile.role,
    description: profile.tagline,
    email: `mailto:${profile.email}`,
    ...(profile.location ? { address: profile.location } : {}),
    ...(sameAs.length ? { sameAs } : {}),
  });
}

if (article) {
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${abs(article.url)}#article`,
    headline: headline(article.title),
    name: article.title,
    description: article.description,
    url: abs(article.url),
    image: [abs(article.image)],
    datePublished: article.publishDate.toISOString(),
    dateModified: (article.updatedDate ?? article.publishDate).toISOString(),
    inLanguage: 'en-GB',
    author: person
      ? { '@id': PERSON_ID }
      : { '@type': 'Person', name: SITE_OWNER, url: abs('/') },
    publisher: { '@type': 'Person', name: SITE_OWNER, url: abs('/') },
    mainEntityOfPage: { '@type': 'WebPage', '@id': abs(article.url) },
    ...(article.section ? { articleSection: article.section } : {}),
    ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
  });
}

if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: abs(crumb.url),
    })),
  });
}

// A literal `</script>` inside a JSON string would close this block early.
// Escaping `<` is the standard defence and stays valid JSON.
const json =
  graph.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
        /</g,
        '\\u003c'
      )
    : null;
---

{json && <script type="application/ld+json" is:inline set:html={json} />}
