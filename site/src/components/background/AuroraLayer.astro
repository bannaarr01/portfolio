---
/**
 * LAYER 1 — aurora.
 *
 * Three soft radial blobs on desynced 22s / 28s / 34s loops. Pure CSS, no JS.
 *
 * Only `transform` is animated. The `filter: blur()` is static, so the browser
 * rasterises each blob once and then composites it — animating the filter, the
 * gradient stops, `background-position` or the box size would repaint every
 * single frame instead, which is the whole reason this layer is written the
 * way it is.
 *
 * Centring uses the standalone `translate` property so the animated
 * `transform` stays exclusively ours: the two compose without fighting.
 */
---

<div class="aurora">
  <i class="blob blob-a"></i>
  <i class="blob blob-b"></i>
  <i class="blob blob-c"></i>
</div>

<style>
  .aurora {
    position: absolute;
    inset: 0;
    opacity: var(--atmos, 1);
  }

  .blob {
    position: absolute;
    display: block;
    translate: -50% -50%;
    border-radius: 50%;
    filter: blur(clamp(24px, 3.6vmax, 52px));
    will-change: transform;
    /* easeInOutSine — waypoints pass through without a visible dwell */
    animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
    animation-iteration-count: infinite;
  }

  /* Negative delays desync the three loops without an opening jump. */

  .blob-a {
    left: 15%;
    top: 85%;
    width: clamp(420px, 70vmax, 980px);
    height: clamp(360px, 58vmax, 840px);
    background: radial-gradient(closest-side, var(--glow-cyan), transparent);
    animation-name: aurora-a;
    animation-duration: 22s;
    animation-delay: -5s;
  }

  .blob-b {
    left: 85%;
    top: 20%;
    width: clamp(380px, 62vmax, 860px);
    height: clamp(340px, 54vmax, 760px);
    background: radial-gradient(closest-side, var(--glow-teal), transparent);
    animation-name: aurora-b;
    animation-duration: 28s;
    animation-delay: -13s;
  }

  .blob-c {
    left: 50%;
    top: 60%;
    width: clamp(440px, 76vmax, 1000px);
    height: clamp(380px, 60vmax, 880px);
    background: radial-gradient(closest-side, var(--glow-deep), transparent);
    animation-name: aurora-c;
    animation-duration: 34s;
    animation-delay: -21s;
  }

  @keyframes aurora-a {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    34% {
      transform: translate3d(5.5vw, -6vh, 0) scale(1.14);
    }
    67% {
      transform: translate3d(-4vw, 3.5vh, 0) scale(0.92);
    }
  }

  @keyframes aurora-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1.04);
    }
    30% {
      transform: translate3d(-6vw, 5vh, 0) scale(0.9);
    }
    62% {
      transform: translate3d(3vw, 8vh, 0) scale(1.16);
    }
  }

  @keyframes aurora-c {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(0.96);
    }
    40% {
      transform: translate3d(7vw, 4vh, 0) scale(1.1);
    }
    72% {
      transform: translate3d(-5vw, -5vh, 0) scale(1.02);
    }
  }

  /*
   * Reduced motion: freeze at a composed pose, not at the origin. Each blob
   * takes a mid-path waypoint so the still frame is a deliberate composition
   * rather than three circles that happen to have stopped.
   */
  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
      will-change: auto;
    }
    .blob-a {
      transform: translate3d(5.5vw, -6vh, 0) scale(1.14);
    }
    .blob-b {
      transform: translate3d(-6vw, 5vh, 0) scale(0.9);
    }
    .blob-c {
      transform: translate3d(7vw, 4vh, 0) scale(1.1);
    }
  }
</style>
