    <p>&copy; {year} — portfolio footer</p>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  p {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--soft);
  }
</style>
