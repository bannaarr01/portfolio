---
/**
 * Section H2 with the gradient accent word and the rule.
 *
 * Gradient text is spent here and on the hero name only (§4.6) — the accent
 * word, never the whole heading.
 *
 * The mono rail index (01, 02 …) that used to sit above the heading is gone,
 * along with its dash. `.rule` below is now the only accent mark on the
 * heading, which is what the centred variant balances around.
 */
import type { SectionCopy } from './types';

interface Props extends SectionCopy {
  align?: 'left' | 'center';
}

const { lead, accent, align = 'left' } = Astro.props;
---

<header class:list={['sh', align]}>
  <h2>{lead} <span class="grad">{accent}</span></h2>
  <div class="rule"></div>
</header>

<style>
  .sh {
    margin-bottom: clamp(38px, 4.2vw, 56px);
  }

  h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .grad {
    background: linear-gradient(96deg, var(--accent-strong), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    /* Real colour + -webkit-text-fill-color, never `color: transparent` —
       transparent text is not an LCP candidate, and it leaves no fallback
       where background-clip:text is unsupported. See Hero.astro. */
    color: var(--accent-strong);
    -webkit-text-fill-color: transparent;
  }

  .rule {
    width: 64px;
    height: 3px;
    margin-top: 18px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  /* Centred variant. The dash that used to flank the index went with it, so
     centring the column is all this needs — `.rule` centres as a flex item. */
  .sh.center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
