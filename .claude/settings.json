{
  "enabledMcpjsonServers": ["playwright", "aws-knowledge", "context7"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-draft-filter.sh\"",
            "timeout": 10,
            "statusMessage": "Checking draft filter"
          }
        ]
      }
    ]
  }
}
