---
/** Education: degrees (divided) alongside a linked certification list. */
import type { Certification, Degree } from '../../types/portfolio';
import Icon from '../ui/Icon.astro';
import Reveal from '../ui/Reveal.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { EducationCardCopy, SectionCopy } from './types';
import './home.css';

interface Props {
  heading: SectionCopy;
  degreesCard: EducationCardCopy;
  degrees: Degree[];
  certificationsCard: EducationCardCopy;
  certifications: Certification[];
}

const { heading, degreesCard, degrees, certificationsCard, certifications } = Astro.props;
---

<Section id="education" band="bg">
  <Reveal><SectionHeading {...heading} /></Reveal>

  <div class="grid">
    <Reveal>
      <article class="card h-card">
        <div class="head">
          <span class="h-badge"><Icon name={degreesCard.icon} size={19} /></span>
          <div>
            <p class="h-kicker">{degreesCard.kicker}</p>
            <h3>{degreesCard.title}</h3>
          </div>
        </div>

        {
          degrees.map((degree) => (
            <div class:list={['degree', { reading: Boolean(degree.status) }]}>
              {/* `period` is optional in practice: a resume often dates jobs
                  but not degrees. Joining on a filtered array keeps the
                  middot a *separator* rather than a prefix — with an empty
                  period the hardcoded ` · ` used to render as a dangling dot
                  before the location. */}
              <p class="h-meta">
                {[degree.period, degree.location].filter(Boolean).join(' · ')}
              </p>
              <h4>{degree.qualification}</h4>
              <p class="inst">{degree.institution}</p>

              {/* The label is the accessible name here; the dot and the sweep
                  are decoration and are hidden, so a screen reader hears
                  "Currently reading" once rather than announcing two unlabelled
                  graphics beside it. */}
              {degree.status && (
                <p class="status">
                  <span class="live" aria-hidden="true" />
                  <span class="status-label">{degree.status}</span>
                  <span class="track" aria-hidden="true">
                    <span class="sweep" />
                  </span>
                </p>
              )}

              {degree.notes.length > 0 && (
                <ul class="h-bullets notes">
                  {degree.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </article>
    </Reveal>

    <Reveal delay={60}>
      <article class="card h-card">
        <div class="head">
          <span class="h-badge">
            <Icon name={certificationsCard.icon} size={19} />
          </span>
          <div>
            <p class="h-kicker">{certificationsCard.kicker}</p>
            <h3>{certificationsCard.title}</h3>
          </div>
        </div>

        <ul class="certs">
          {
            certifications.map((cert) => (
              <li>
                {/* A credential without a verification URL renders as plain
                    text. Linking it to `#` or to an empty href would give the
                    row a pointer, a focus stop and an external-link icon that
                    all promise a verification page there is no URL for. */}
                {cert.url ? (
                  <a href={cert.url} rel="noopener noreferrer" target="_blank">
                    <span class="cert-text">
                      <strong>{cert.title}</strong>
                      <span class="issuer">{cert.issuer}</span>
                    </span>
                    <Icon name="external-link" size={15} />
                  </a>
                ) : (
                  <div class="cert-static">
                    <span class="cert-text">
                      <strong>{cert.title}</strong>
                      <span class="issuer">{cert.issuer}</span>
                    </span>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </article>
    </Reveal>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 22px);
  }

  .grid > :global(*) {
    height: 100%;
  }

  .card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 28px 26px 26px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .head h3 {
    margin: 4px 0 0;
    color: var(--text);
    font-size: 20px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.028em;
  }

  /* ---------------------------------------------------------- degrees -- */

  .degree + .degree {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .degree h4 {
    margin: 8px 0 5px;
    color: var(--text);
    font-size: 16.5px;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }

  .inst {
    margin: 0;
    color: var(--accent-strong);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .notes {
    margin-top: 12px;
  }

  .notes > :global(li) {
    font-size: 14px;
  }

  /* ------------------------------------------------------ in progress -- */

  /* A degree still being read. The rail is what separates it at a glance:
     the completed entries are divided by a neutral hairline *above* them,
     so an accent hairline down the side reads as a different axis rather
     than a louder version of the same one. */
  .degree.reading {
    position: relative;
    padding-left: 15px;
  }

  .degree.reading::before {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, var(--accent-strong), var(--accent-2));
    content: '';
  }

  .status {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 12px 0 0;
  }

  /* Accent, not `--success`. The Hero's availability dot is green and means
     "open to work"; reusing that colour here would read as a second hiring
     signal rather than an enrolment. Same geometry, different channel. */
  .live {
    position: relative;
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .status-label {
    flex: none;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Indeterminate on purpose — see the note in `data/education.ts`. The Hero's
     XP bar fills to a real number; this one has no number to fill to, so it
     travels instead. A half-filled meter here would be invented data. */
  .track {
    position: relative;
    overflow: hidden;
    min-width: 34px;
    height: 2px;
    flex: 1;
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  /* Resting state, and the only state under reduced motion: a soft accent
     line sitting in the track rather than an empty grey slot. */
  .sweep {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent),
      var(--accent-2),
      transparent
    );
  }

  /* ----------------------------------------------------- certificates -- */

  .certs {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs a,
  .certs .cert-static {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--band, var(--bg));
    color: var(--text);
    transition:
      border-color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
      background-color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  /* Hover affordance belongs only to the rows that actually go somewhere. */
  .certs a:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-soft);
  }

  .cert-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .cert-text strong {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  .issuer {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: -0.005em;
  }

  .certs a :global(svg) {
    flex: none;
    color: var(--muted);
    transition: color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .certs a:hover :global(svg) {
    color: var(--accent-strong);
  }

  /* ----------------------------------------------------------- motion -- */

  /* Opt-in, matching Hero.astro: the animation is *added* when motion is
     welcome rather than removed when it isn't, so the reduced-motion path is
     the one that needs no override to be correct. `global.css` clamps
     durations under `reduce` as a second belt. Both properties here are
     compositor-only. */
  @media (prefers-reduced-motion: no-preference) {
    .live::after {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent);
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
      content: '';
    }

    .sweep {
      animation: sweep 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
  }

  /* Keyframes are component-scoped in Astro, so this is a local twin of the
     Hero's dot pulse rather than a shared one. */
  @keyframes ping {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  @keyframes sweep {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .card {
      padding: 24px 20px 22px;
    }
  }
</style>
