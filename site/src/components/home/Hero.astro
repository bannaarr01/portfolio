---
/**
 * Homepage hero. Fills the viewport below the sticky header, with group 02's
 * BackgroundField behind and all content at z-index 1.
 *
 * Entrance is a pure-CSS load stagger (no IntersectionObserver): the hero is
 * above the fold, so it must not wait on an observer callback to paint.
 */
import BackgroundField from '../background/BackgroundField.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import HeroHud from './HeroHud.astro';
import type { HeroContent } from './types';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;

/** "LVL 4" reads like a typo next to a two-digit XP figure. Pad it. */
const level = String(content.hud.level).padStart(2, '0');
---

<section class="hero" id="top">
  <BackgroundField density="full" />
  <div class="veil" aria-hidden="true"></div>

  <div class="inner">
    {
      /* Player card. Two rows: status + level, then the XP bar. The level and
        the XP figure are both derived from a career start date at build time
        — see `data/hud.ts`. */
    }
    <div class="pill" style={`--i: 0; --xp: ${content.hud.xp}`}>
      <span class="prow">
        <span class="dot" aria-hidden="true"></span>
        {content.availability}
        <span class="sep" aria-hidden="true"></span>
        <span class="lvl">LVL {level}</span>
      </span>
      <span class="prow">
        <span class="xp-track" aria-hidden="true">
          <span class="xp-fill"></span>
        </span>
        <span class="xp-label">{content.hud.xpLabel}</span>
      </span>
    </div>

    <h1 style="--i: 1">
      {content.greeting}{' '}
      <span class="name">{content.name}</span>
    </h1>

    <p class="role" style="--i: 2">
      <span class="hair" aria-hidden="true"></span>
      {content.role}
      <span class="hair" aria-hidden="true"></span>
    </p>

    <p class="lead" style="--i: 3">{content.lead}</p>

    {
      /* The standalone location row folded into the HUD's header — it was a
        whole 38px band carrying one word, and the HUD needed a right-hand
        item. */
    }
    <div class="hudwrap" style="--i: 4">
      <HeroHud hud={content.hud} location={content.location} />
    </div>

    <div class="actions" style="--i: 5">
      <Button variant="primary" href={content.primaryCta.href}>
        {content.primaryCta.label}
        <Icon name={content.primaryCta.icon} size={16} />
      </Button>
      <Button variant="secondary" href={content.secondaryCta.href}>
        {content.secondaryCta.label}
        <Icon name={content.secondaryCta.icon} size={16} />
      </Button>
    </div>

    {
      /* Two elements on purpose — see the `.cue` rules below: the link carries
        the perpetual bounce, the ring inside carries hover and press. */
    }
    <a class="cue" href={content.scrollCueHref} aria-label={content.scrollCueLabel}>
      <span class="cue-ring">
        <Icon name="arrow-down" size={16} />
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    /* vh first so browsers without dvh still fill; dvh wins where supported
       and absorbs mobile browser chrome. */
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100dvh - var(--header-h));
    /* Trimmed from 72/108 when the HUD landed — the panel adds roughly 130px
       and this is where it came from. */
    padding: 40px 0 48px;
    overflow: hidden;
    background: var(--hero-bg);
    isolation: isolate;
  }

  /* Bloom behind the name + fade into the About band below. */
  .veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 62% 44% at 50% 36%, var(--glow-cyan), transparent 70%),
      linear-gradient(to bottom, transparent 52%, var(--bg) 99%);
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: var(--container);
    flex-direction: column;
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  /* ------------------------------------------------------------ pill -- */

  /* No longer a pill in the strict sense — a two-row card, still pill-radiused
     so it reads as the same object it was. Width is content-driven and capped
     so the XP bar has a sane length at any viewport. */
  .pill {
    display: flex;
    width: max-content;
    max-width: 100%;
    flex-direction: column;
    gap: 7px;
    margin: 0 0 18px;
    padding: 9px 16px 10px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--header-bg);
    backdrop-filter: blur(20px) saturate(180%);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .prow {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .sep {
    width: 1px;
    height: 13px;
    flex: none;
    margin-inline: 2px;
    background: var(--border-strong);
  }

  .lvl {
    flex: none;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  /* ---------------------------------------------------------------- xp -- */

  .xp-track {
    position: relative;
    display: block;
    min-width: 120px;
    height: 4px;
    flex: 1;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--border-strong);
  }

  /* `scaleX` rather than an animated `width`, so the fill is compositor-only.
     `--xp` is a 0–100 integer set inline on `.pill`. */
  .xp-fill {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(calc(var(--xp) / 100));
    transform-origin: left center;
  }

  .xp-label {
    flex: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dot {
    position: relative;
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 22%, transparent);
  }

  /* -------------------------------------------------------------- h1 -- */

  h1 {
    max-width: 16ch;
    margin: 0;
    color: var(--text);
    font-size: clamp(42px, 5.4vw, 78px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .name {
    background: linear-gradient(96deg, var(--accent-strong), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    /* NOT `color: transparent`.

       Chrome excludes fully transparent text from Largest Contentful Paint
       candidacy. This is the largest text above the fold, and at Lighthouse's
       412px mobile viewport it was the *only* candidate — so the homepage
       reported NO_LCP, which nulls LCP, TBT and TTI and scores performance 0.
       A real browser at desktop width found other text and looked fine, which
       is why this only ever showed up in CI.

       `-webkit-text-fill-color` paints the identical result while leaving
       `color` a real value, so the element stays an LCP candidate. It also
       doubles as the fallback wherever `background-clip: text` is unsupported,
       which `color: transparent` never was — there the text was invisible.

       Same reasoning applies to every gradient-text rule in this project. */
    color: var(--accent-strong);
    -webkit-text-fill-color: transparent;
  }

  /* ------------------------------------------------------------ role -- */

  /* Mono, uppercase, hairline-flanked. With the serif gone (§4.4) the mono
     face is what separates "engineer" from "generic portfolio". */
  .role {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 18px 0 0;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.35vw, 13.5px);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hair {
    width: clamp(18px, 5vw, 46px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent));
  }

  .role .hair:last-child {
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  /* ------------------------------------------------------- lead / loc -- */

  .lead {
    max-width: 62ch;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: clamp(15.5px, 1.7vw, 17.5px);
    line-height: 1.68;
  }

  /* `.inner` is a centred flex column, so the HUD needs a wrapper to be the
     stagger participant while the panel itself sizes to its own max-width. */
  .hudwrap {
    display: flex;
    width: 100%;
    justify-content: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  /* ------------------------------------------------------------- cue -- */

  /* In flow at the end of `.inner`, not pinned to the bottom of the section.
     Pinned, the gap between the CTAs and the cue was whatever the viewport
     height left over — small on a laptop, a void on a tall monitor. Sitting it
     a fixed distance below the buttons keeps the lockup reading as one group
     at every height, and the hero still fills the viewport either way. */
  /* Split across two elements deliberately. Both the idle bounce and the hover
     lift want `transform`, and a running animation always beats a transition on
     the same property — on one element the bounce simply eats the hover. The
     link owns the bounce, the ring inside owns hover and press, and the two
     transforms compose because they sit on different elements. */
  .cue {
    display: block;
    margin-top: 20px;
    border-radius: 999px;
    color: var(--muted);
    transition: color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .cue-ring {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: inherit;
    background: var(--header-bg);
    backdrop-filter: blur(20px) saturate(180%);
    transition:
      border-color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
      box-shadow 240ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
      transform 240ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .cue-ring :global(.icon) {
    transition: transform 240ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  /* Keyboard gets the same treatment as the mouse: the affordance is the point,
     and it should not be mouse-only. */
  .cue:hover,
  .cue:focus-visible {
    color: var(--accent-strong);
  }

  .cue:hover .cue-ring,
  .cue:focus-visible .cue-ring {
    border-color: var(--accent);
    box-shadow: var(--glow-cta-hover);
  }

  /* ---------------------------------------------------------- motion -- */

  @media (prefers-reduced-motion: no-preference) {
    .inner > * {
      animation: rise 620ms cubic-bezier(0.4, 0, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    .dot::after {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--success);
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
      content: '';
    }

    /* Fills first, before the meters in the HUD below — the player card is
       the top of the readout, so it should be the first thing to charge. */
    .xp-fill {
      animation: charge 900ms cubic-bezier(0.22, 1, 0.36, 1) 260ms both;
    }

    /* `.inner > .cue`, not `.cue` — and this is not stylistic.
       Astro scopes `.inner > *` to `.inner[data-astro-cid] > [data-astro-cid]`:
       one class plus TWO attribute selectors, (0,3,0). A bare `.cue` scopes to
       `.cue[data-astro-cid]`, only (0,2,0), so the stagger rule above outranks
       it and the bounce never applies — no source order involved. Qualifying by
       the parent makes this (0,4,0) and puts the cue back in charge of its own
       animation. The cue used to sit outside `.inner`, where the stagger could
       not reach it; moving it in beside the buttons is what exposed this. */
    .inner > .cue {
      animation:
        rise 620ms cubic-bezier(0.4, 0, 0.2, 1) 460ms both,
        bob 1.9s cubic-bezier(0.45, 0, 0.55, 1) 1.1s infinite;
    }

    /* Scale rather than a lift: the ring is already travelling vertically, and
       stacking a second vertical move on top of the bounce reads as a wobble. */
    .cue:hover .cue-ring,
    .cue:focus-visible .cue-ring {
      transform: scale(1.12);
    }

    /* The arrow leads, so the button says "down" before you have clicked it. */
    .cue:hover .cue-ring :global(.icon),
    .cue:focus-visible .cue-ring :global(.icon) {
      transform: translateY(2px);
    }

    /* Press: quick and shallow, so the click lands rather than bounces. */
    .cue:active .cue-ring {
      transform: scale(0.94);
      transition-duration: 90ms;
    }
  }

  /*
    Transform only — deliberately no `opacity: 0` start.

    Chrome will not treat an element as a Largest Contentful Paint candidate if
    it is fully transparent when first painted, and it does not reconsider that
    element once the fade finishes. Every child of `.inner` shares this
    animation, so fading them in left the homepage with no LCP candidate at all
    above the fold: Lighthouse reported NO_LCP, which nulls LCP, TBT and TTI and
    collapses the performance score to 0.

    It only ever reproduced at narrow viewports, because at desktop widths an
    element outside the stagger happened to qualify — which is why a real
    browser at desktop size looked perfectly healthy.

    Raising the floor to a small non-zero opacity would silence the metric
    without fixing anything, so: the entrance is a rise, not a fade. The text is
    legible from the first frame, which is what the metric is trying to measure
    in the first place.
  */
  @keyframes rise {
    from {
      transform: translateY(14px);
    }
  }

  @keyframes ping {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  /* Down, then a short overshoot back above the resting line, then settle —
     a nudge rather than a float. The old 5px over 2.6s was slow and shallow
     enough to read as a static button. */
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    45% {
      transform: translateY(9px);
    }
    75% {
      transform: translateY(-3px);
    }
  }

  /* From-only, so the implicit `to` is the element's own
     `scaleX(var(--xp) / 100)` — the bar's real value stays in one place. */
  @keyframes charge {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-bottom: 72px;
    }
  }

  /* Once the role wraps, the hairlines are stranded at the container edges
     instead of hugging the text — drop them rather than let them float. */
  @media (max-width: 620px) {
    .hair {
      display: none;
    }

    .role {
      gap: 0;
    }
  }

  /* Stacked CTAs of unequal width read as ragged; make them share a width. */
  @media (max-width: 430px) {
    .actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .actions > :global(*) {
      justify-content: center;
    }
  }
</style>
