{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "icons": "node scripts/gen-icons.mjs",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,css,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,css,json,md,yaml}\"",
    "no-hex": "! grep -rEn '#[0-9a-fA-F]{3,8}' src --include='*.astro' --include='*.css' | grep -v 'styles/tokens.css'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.2.9",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.4",
    "unist-util-visit": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
