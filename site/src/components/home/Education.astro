---
/** Education: degrees (divided) alongside a linked certification list. */
import type { Certification, Degree } from '../../types/portfolio';
import Icon from '../ui/Icon.astro';
import Reveal from '../ui/Reveal.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { EducationCardCopy, SectionCopy } from './types';
import './home.css';

interface Props {
  heading: SectionCopy;
  degreesCard: EducationCardCopy;
  degrees: Degree[];
  certificationsCard: EducationCardCopy;
  certifications: Certification[];
}

const { heading, degreesCard, degrees, certificationsCard, certifications } = Astro.props;
---

<Section id="education" band="bg">
  <Reveal><SectionHeading {...heading} /></Reveal>

  <div class="grid">
    <Reveal>
      <article class="card h-card">
        <div class="head">
          <span class="h-badge"><Icon name={degreesCard.icon} size={19} /></span>
          <div>
            <p class="h-kicker">{degreesCard.kicker}</p>
            <h3>{degreesCard.title}</h3>
          </div>
        </div>

        {
          degrees.map((degree) => (
            <div class="degree">
              <p class="h-meta">
                {degree.period} &middot; {degree.location}
              </p>
              <h4>{degree.qualification}</h4>
              <p class="inst">{degree.institution}</p>
              {degree.notes.length > 0 && (
                <ul class="h-bullets notes">
                  {degree.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </article>
    </Reveal>

    <Reveal delay={60}>
      <article class="card h-card">
        <div class="head">
          <span class="h-badge">
            <Icon name={certificationsCard.icon} size={19} />
          </span>
          <div>
            <p class="h-kicker">{certificationsCard.kicker}</p>
            <h3>{certificationsCard.title}</h3>
          </div>
        </div>

        <ul class="certs">
          {
            certifications.map((cert) => (
              <li>
                <a href={cert.url} rel="noopener noreferrer" target="_blank">
                  <span class="cert-text">
                    <strong>{cert.title}</strong>
                    <span class="issuer">{cert.issuer}</span>
                  </span>
                  <Icon name="external-link" size={15} />
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </Reveal>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 22px);
  }

  .grid > :global(*) {
    height: 100%;
  }

  .card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 28px 26px 26px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .head h3 {
    margin: 4px 0 0;
    color: var(--text);
    font-size: 20px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.028em;
  }

  /* ---------------------------------------------------------- degrees -- */

  .degree + .degree {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .degree h4 {
    margin: 8px 0 5px;
    color: var(--text);
    font-size: 16.5px;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }

  .inst {
    margin: 0;
    color: var(--accent-strong);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .notes {
    margin-top: 12px;
  }

  .notes > :global(li) {
    font-size: 14px;
  }

  /* ----------------------------------------------------- certificates -- */

  .certs {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--band, var(--bg));
    color: var(--text);
    transition:
      border-color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
      background-color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .certs a:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-soft);
  }

  .cert-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .cert-text strong {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  .issuer {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: -0.005em;
  }

  .certs a :global(svg) {
    flex: none;
    color: var(--muted);
    transition: color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .certs a:hover :global(svg) {
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .card {
      padding: 24px 20px 22px;
    }
  }
</style>
