---
/** About: prose column + the figures readout, stacking at 900px. */
import type { Stat } from '../../types/portfolio';
import Reveal from '../ui/Reveal.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { AboutContent, SectionCopy } from './types';
import './home.css';

interface Props {
  heading: SectionCopy;
  content: AboutContent;
  stats: Stat[];
}

const { heading, content, stats } = Astro.props;

/**
 * Split "50+" into the figure and its qualifier so they can be set in
 * different type. The figures then sit in one tabular-numeral column and stay
 * optically aligned down the panel instead of each being nudged right by the
 * width of its own "+".
 *
 * A value with no qualifier falls through with an empty string, and a value
 * that does not start with digits is left whole rather than mangled.
 */
const rows = stats.map((stat) => {
  const [, figure = stat.value, qualifier = ''] = /^([\d.,]+)(.*)$/.exec(stat.value) ?? [];
  return { ...stat, figure, qualifier };
});
---

<Section id="about" band="bg">
  <Reveal><SectionHeading {...heading} /></Reveal>

  <div class="grid">
    <Reveal>
      <div class="copy">
        {content.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </Reveal>

    <dl class="stats">
      {
        /*
          `Reveal` renders the row itself rather than wrapping it. Two nested
          divs between <dl> and its <dt>/<dd> breaks the definition-list
          grouping rule: at most one wrapper element is allowed there, and
          axe (so Lighthouse) fails both `definition-list` and `dlitem` on it.

          <dt> before <dd> is required, and here it is also what you want to
          read: the row lays out left to right, so the label precedes its
          figure visually and in the accessibility tree. The old 2×2 card
          reversed them with `column-reverse` to put the figure on top; the
          readout needs no such trick.

          The row styles live in `home.css`, not in this file's scoped block.
          See the note above `.stats` there — it is a real trap, not a
          preference.
        */
        rows.map((row, i) => (
          <Reveal as="div" class="stat" delay={i * 60}>
            <dt>{row.label}</dt>
            <dd>
              {row.figure}
              {row.qualifier && <span class="stat-unit">{row.qualifier}</span>}
            </dd>
          </Reveal>
        ))
      }
    </dl>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(32px, 4.4vw, 60px);
  }

  .copy {
    display: grid;
    gap: 18px;
  }

  .copy :global(p) {
    margin: 0;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.72;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
