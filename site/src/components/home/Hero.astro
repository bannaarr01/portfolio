---
/**
 * Homepage hero. Fills the viewport below the sticky header, with group 02's
 * BackgroundField behind and all content at z-index 1.
 *
 * Entrance is a pure-CSS load stagger (no IntersectionObserver): the hero is
 * above the fold, so it must not wait on an observer callback to paint.
 */
import BackgroundField from '../background/BackgroundField.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { HeroContent } from './types';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section class="hero" id="top">
  <BackgroundField density="full" />
  <div class="veil" aria-hidden="true"></div>

  <div class="inner">
    <p class="pill" style="--i: 0">
      <span class="dot" aria-hidden="true"></span>
      {content.availability}
    </p>

    <h1 style="--i: 1">
      {content.greeting}{' '}
      <span class="name">{content.name}</span>
    </h1>

    <p class="role" style="--i: 2">
      <span class="hair" aria-hidden="true"></span>
      {content.role}
      <span class="hair" aria-hidden="true"></span>
    </p>

    <p class="lead" style="--i: 3">{content.lead}</p>

    <p class="loc" style="--i: 4">
      <Icon name="map-pin" size={14} />
      {content.location}
    </p>

    <div class="actions" style="--i: 5">
      <Button variant="primary" href={content.primaryCta.href}>
        {content.primaryCta.label}
        <Icon name={content.primaryCta.icon} size={16} />
      </Button>
      <Button variant="secondary" href={content.secondaryCta.href}>
        {content.secondaryCta.label}
        <Icon name={content.secondaryCta.icon} size={16} />
      </Button>
    </div>
  </div>

  <a class="cue" href={content.scrollCueHref} aria-label={content.scrollCueLabel}>
    <Icon name="arrow-down" size={16} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    /* vh first so browsers without dvh still fill; dvh wins where supported
       and absorbs mobile browser chrome. */
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100dvh - var(--header-h));
    padding: 72px 0 108px;
    overflow: hidden;
    background: var(--hero-bg);
    isolation: isolate;
  }

  /* Bloom behind the name + fade into the About band below. */
  .veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 62% 44% at 50% 36%, var(--glow-cyan), transparent 70%),
      linear-gradient(to bottom, transparent 52%, var(--bg) 99%);
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: var(--container);
    flex-direction: column;
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  /* ------------------------------------------------------------ pill -- */

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 26px;
    padding: 7px 15px 7px 13px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--header-bg);
    backdrop-filter: blur(20px) saturate(180%);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .dot {
    position: relative;
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 22%, transparent);
  }

  /* -------------------------------------------------------------- h1 -- */

  h1 {
    max-width: 16ch;
    margin: 0;
    color: var(--text);
    font-size: clamp(42px, 5.4vw, 78px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .name {
    background: linear-gradient(96deg, var(--accent-strong), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ------------------------------------------------------------ role -- */

  /* Mono, uppercase, hairline-flanked. With the serif gone (§4.4) the mono
     face is what separates "engineer" from "generic portfolio". */
  .role {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 22px 0 0;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.35vw, 13.5px);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hair {
    width: clamp(18px, 5vw, 46px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent));
  }

  .role .hair:last-child {
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  /* ------------------------------------------------------- lead / loc -- */

  .lead {
    max-width: 62ch;
    margin: 26px 0 0;
    color: var(--muted);
    font-size: clamp(15.5px, 1.7vw, 17.5px);
    line-height: 1.68;
  }

  .loc {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 20px 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: -0.005em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }

  /* ------------------------------------------------------------- cue -- */

  .cue {
    position: absolute;
    bottom: 34px;
    left: 50%;
    z-index: 1;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    margin-left: -19px;
    background: var(--header-bg);
    backdrop-filter: blur(20px) saturate(180%);
    color: var(--muted);
    transition:
      color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
      border-color 180ms var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .cue:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  /* ---------------------------------------------------------- motion -- */

  @media (prefers-reduced-motion: no-preference) {
    .inner > * {
      animation: rise 620ms cubic-bezier(0.4, 0, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    .dot::after {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--success);
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
      content: '';
    }

    .cue {
      animation:
        rise 620ms cubic-bezier(0.4, 0, 0.2, 1) 460ms both,
        bob 2.6s cubic-bezier(0.4, 0, 0.2, 1) 1.1s infinite;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes ping {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-bottom: 92px;
    }
  }

  /* Once the role wraps, the hairlines are stranded at the container edges
     instead of hugging the text — drop them rather than let them float. */
  @media (max-width: 620px) {
    .hair {
      display: none;
    }

    .role {
      gap: 0;
    }
  }

  /* Stacked CTAs of unequal width read as ragged; make them share a width. */
  @media (max-width: 430px) {
    .actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .actions > :global(*) {
      justify-content: center;
    }
  }
</style>
