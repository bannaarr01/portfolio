---
/**
 * A pill for tech chips and taxonomy labels. Renders a bare `<span>` — the
 * caller decides whether it sits in a `<ul>`, a link, or loose in a row.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span class:list={['tag', className]}>{label}</span>

<style>
  .tag {
    display: inline-block;
    padding: 4px 11px;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.6;
    white-space: nowrap;
  }
</style>
